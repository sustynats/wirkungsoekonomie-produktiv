# Add zone once to the existing nginx http block, after backup/config review.
limit_req_zone $binary_remote_addr zone=woek_booking:1m rate=30r/m;

# Add location to the existing HTTPS wirkungsoekonomie.de server block.
# API and public profile must share this origin. No Vercel Function is needed.
location ^~ /api/telephone-booking/ {
    limit_req zone=woek_booking burst=12 nodelay;
    limit_req_status 429;
    client_max_body_size 24k;
    proxy_pass http://127.0.0.1:8765;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 110s;
    # Never log OAuth codes, verification tokens, request bodies or bearer headers.
    access_log off;
    error_log /var/log/nginx/woek-booking-error.log crit;
    proxy_no_cache 1;
    proxy_cache_bypass 1;
}
