# Private runtime configuration ONLY. Real values live outside Git on OCI.
# BOOKING_ENABLED remains 0 until proxy, queue, mail, OAuth and smoke tests pass.
BOOKING_ENABLED=0
BOOKING_ORIGIN=https://130.162.217.58.sslip.io
BOOKING_FRONTEND_ORIGIN=https://wirkungsoekonomie.de
BOOKING_DB=/var/lib/woek-telephone-booking/booking.sqlite3
BOOKING_SECRET=
BOOKING_TRUST_PROXY=1

# Reuse the established bot + recipient; never create a public webhook.
DISCORD_BOT_TOKEN=
DISCORD_REVIEW_RECIPIENT_USER_ID=
# Existing Discord application, with the callback registered exactly:
# https://130.162.217.58.sslip.io/api/telephone-booking/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Existing IONOS SMTP credentials, or existing REVIEW_NOTIFICATION_SMTP_*,
# WIRKUNGSRADAR_SMTP_* / WOEK_NEWSLETTER_SMTP_* env names as fallbacks.
BOOKING_SMTP_HOST=smtp.ionos.de
BOOKING_SMTP_PORT=587
BOOKING_SMTP_USER=
BOOKING_SMTP_PASSWORD=
BOOKING_SMTP_FROM=

# Independent server connection, not the interactive Codex iCloud connection.
# setup_icloud.py writes credentials to /etc/woek-telephone-booking-icloud.env.
# systemd reads that private file after this base configuration.
# A disabled calendar prevents offering production slots.
BOOKING_ICLOUD_ENABLED=0

# Separate private Institut server-to-server CRM credential; at least 32 random chars.
# Never expose /internal/crm through a public proxy.
BOOKING_CRM_TOKEN=
