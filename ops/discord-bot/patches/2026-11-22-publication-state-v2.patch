+export function publicationKey(item: { channelId: string; url: string }): string {
+  return `${item.channelId}|${normalizeFeedId(item.url)}`;
+}
+
+function savePublicationState(file: string, state: WebsiteFeedState, seen: Set<string>): void {
+  state.seenIds = [...seen];
+  state.lastCheckedAt = new Date().toISOString();
+  writeFeedState(file, state);
+}
+
+function definiteRejection(error: unknown): boolean {
+  const status = (error as { status?: number })?.status;
+  return typeof status === "number" && status >= 400 && status < 500 && status !== 408;
+}
+
+async function deliverPublication(file: string, state: WebsiteFeedState, seen: Set<string>, item: RoutedWebsiteFeedItem, send: () => Promise<void>): Promise<void> {
+  const key = publicationKey(item);
+  state.pending ||= {};
+  state.pending[key] = { channelId: item.channelId, url: item.url, reservedAt: new Date().toISOString() };
+  seen.add(key);
+  // Persist the reservation before Discord can accept the message.
+  savePublicationState(file, state, seen);
+  try {
+    await send();
+  } catch (error) {
+    if (definiteRejection(error)) {
+      delete state.pending[key];
+      seen.delete(key);
+      savePublicationState(file, state, seen);
+    }
+    throw error;
+  }
+  delete state.pending[key];
+  savePublicationState(file, state, seen);
+}
